{
  "schema_version": 1,
  "description": "semver_eq, semver_lt and semver_gt: SemVer 2.0.0 precedence, build metadata ignored, invalid versions never match. Each flag serves on from a rule on attr and falls through to off.",
  "ruleset": {
    "schema_version": 1,
    "project": "conformance",
    "environment": "test",
    "flags": {
      "lt-release": {"key": "lt-release", "type": "boolean", "enabled": true, "version": 1,
        "variations": [{"key": "on", "value": true}, {"key": "off", "value": false}], "off_variation": "off",
        "prerequisites": [], "targets": [],
        "rules": [{"description": "", "clauses": [{"attribute": "attr", "operator": "semver_lt", "values": ["1.0.0"], "negate": false}], "serve": {"variation": "on"}}],
        "fallthrough": {"variation": "off"}},
      "lt-alpha-1": {"key": "lt-alpha-1", "type": "boolean", "enabled": true, "version": 1,
        "variations": [{"key": "on", "value": true}, {"key": "off", "value": false}], "off_variation": "off",
        "prerequisites": [], "targets": [],
        "rules": [{"description": "", "clauses": [{"attribute": "attr", "operator": "semver_lt", "values": ["1.0.0-alpha.1"], "negate": false}], "serve": {"variation": "on"}}],
        "fallthrough": {"variation": "off"}},
      "gt-beta-2": {"key": "gt-beta-2", "type": "boolean", "enabled": true, "version": 1,
        "variations": [{"key": "on", "value": true}, {"key": "off", "value": false}], "off_variation": "off",
        "prerequisites": [], "targets": [],
        "rules": [{"description": "", "clauses": [{"attribute": "attr", "operator": "semver_gt", "values": ["1.0.0-beta.2"], "negate": false}], "serve": {"variation": "on"}}],
        "fallthrough": {"variation": "off"}},
      "gt-1-9": {"key": "gt-1-9", "type": "boolean", "enabled": true, "version": 1,
        "variations": [{"key": "on", "value": true}, {"key": "off", "value": false}], "off_variation": "off",
        "prerequisites": [], "targets": [],
        "rules": [{"description": "", "clauses": [{"attribute": "attr", "operator": "semver_gt", "values": ["1.9.0"], "negate": false}], "serve": {"variation": "on"}}],
        "fallthrough": {"variation": "off"}},
      "eq": {"key": "eq", "type": "boolean", "enabled": true, "version": 1,
        "variations": [{"key": "on", "value": true}, {"key": "off", "value": false}], "off_variation": "off",
        "prerequisites": [], "targets": [],
        "rules": [{"description": "", "clauses": [{"attribute": "attr", "operator": "semver_eq", "values": ["1.2.3"], "negate": false}], "serve": {"variation": "on"}}],
        "fallthrough": {"variation": "off"}},
      "eq-build": {"key": "eq-build", "type": "boolean", "enabled": true, "version": 1,
        "variations": [{"key": "on", "value": true}, {"key": "off", "value": false}], "off_variation": "off",
        "prerequisites": [], "targets": [],
        "rules": [{"description": "", "clauses": [{"attribute": "attr", "operator": "semver_eq", "values": ["1.2.3+build.1"], "negate": false}], "serve": {"variation": "on"}}],
        "fallthrough": {"variation": "off"}},
      "invalid-value": {"key": "invalid-value", "type": "boolean", "enabled": true, "version": 1,
        "variations": [{"key": "on", "value": true}, {"key": "off", "value": false}], "off_variation": "off",
        "prerequisites": [], "targets": [],
        "rules": [{"description": "", "clauses": [{"attribute": "attr", "operator": "semver_eq", "values": ["v1.2.3"], "negate": false}], "serve": {"variation": "on"}}],
        "fallthrough": {"variation": "off"}}
    },
    "segments": {}
  },
  "tests": [
    {"name": "prerelease-below-release", "flag": "lt-release", "context": {"key": "u", "attr": "1.0.0-rc.1"}, "default": false,
     "expected": {"value": true, "variant": "on", "reason": "TARGETING_MATCH", "error_code": null, "metadata": {"rule_index": 0}}},
    {"name": "release-not-below-itself", "flag": "lt-release", "context": {"key": "u", "attr": "1.0.0"}, "default": false,
     "expected": {"value": false, "variant": "off", "reason": "DEFAULT", "error_code": null, "metadata": {}}},
    {"name": "alpha-below-alpha-1", "flag": "lt-alpha-1", "context": {"key": "u", "attr": "1.0.0-alpha"}, "default": false,
     "expected": {"value": true, "variant": "on", "reason": "TARGETING_MATCH", "error_code": null, "metadata": {"rule_index": 0}}},
    {"name": "alpha-beta-not-below-alpha-1", "flag": "lt-alpha-1", "context": {"key": "u", "attr": "1.0.0-alpha.beta"}, "default": false,
     "expected": {"value": false, "variant": "off", "reason": "DEFAULT", "error_code": null, "metadata": {}}},
    {"name": "numeric-identifiers-compare-numerically", "flag": "gt-beta-2", "context": {"key": "u", "attr": "1.0.0-beta.11"}, "default": false,
     "expected": {"value": true, "variant": "on", "reason": "TARGETING_MATCH", "error_code": null, "metadata": {"rule_index": 0}}},
    {"name": "shorter-prerelease-is-lower", "flag": "gt-beta-2", "context": {"key": "u", "attr": "1.0.0-beta"}, "default": false,
     "expected": {"value": false, "variant": "off", "reason": "DEFAULT", "error_code": null, "metadata": {}}},
    {"name": "alpha-beta-below-beta-2", "flag": "gt-beta-2", "context": {"key": "u", "attr": "1.0.0-alpha.beta"}, "default": false,
     "expected": {"value": false, "variant": "off", "reason": "DEFAULT", "error_code": null, "metadata": {}}},
    {"name": "rc-above-beta", "flag": "gt-beta-2", "context": {"key": "u", "attr": "1.0.0-rc.1"}, "default": false,
     "expected": {"value": true, "variant": "on", "reason": "TARGETING_MATCH", "error_code": null, "metadata": {"rule_index": 0}}},
    {"name": "release-above-prerelease", "flag": "gt-beta-2", "context": {"key": "u", "attr": "1.0.0"}, "default": false,
     "expected": {"value": true, "variant": "on", "reason": "TARGETING_MATCH", "error_code": null, "metadata": {"rule_index": 0}}},
    {"name": "minor-compares-numerically", "flag": "gt-1-9", "context": {"key": "u", "attr": "1.10.0"}, "default": false,
     "expected": {"value": true, "variant": "on", "reason": "TARGETING_MATCH", "error_code": null, "metadata": {"rule_index": 0}}},
    {"name": "smaller-minor", "flag": "gt-1-9", "context": {"key": "u", "attr": "1.8.9"}, "default": false,
     "expected": {"value": false, "variant": "off", "reason": "DEFAULT", "error_code": null, "metadata": {}}},
    {"name": "eq-hit", "flag": "eq", "context": {"key": "u", "attr": "1.2.3"}, "default": false,
     "expected": {"value": true, "variant": "on", "reason": "TARGETING_MATCH", "error_code": null, "metadata": {"rule_index": 0}}},
    {"name": "eq-build-metadata-ignored", "flag": "eq", "context": {"key": "u", "attr": "1.2.3+build.5"}, "default": false,
     "expected": {"value": true, "variant": "on", "reason": "TARGETING_MATCH", "error_code": null, "metadata": {"rule_index": 0}}},
    {"name": "eq-build-metadata-ignored-in-value", "flag": "eq-build", "context": {"key": "u", "attr": "1.2.3"}, "default": false,
     "expected": {"value": true, "variant": "on", "reason": "TARGETING_MATCH", "error_code": null, "metadata": {"rule_index": 0}}},
    {"name": "eq-miss", "flag": "eq", "context": {"key": "u", "attr": "1.2.4"}, "default": false,
     "expected": {"value": false, "variant": "off", "reason": "DEFAULT", "error_code": null, "metadata": {}}},
    {"name": "eq-prerelease-is-not-release", "flag": "eq", "context": {"key": "u", "attr": "1.2.3-rc.1"}, "default": false,
     "expected": {"value": false, "variant": "off", "reason": "DEFAULT", "error_code": null, "metadata": {}}},
    {"name": "invalid-attribute-v-prefix", "flag": "eq", "context": {"key": "u", "attr": "v1.2.3"}, "default": false,
     "expected": {"value": false, "variant": "off", "reason": "DEFAULT", "error_code": null, "metadata": {}}},
    {"name": "invalid-attribute-two-parts", "flag": "eq", "context": {"key": "u", "attr": "1.2"}, "default": false,
     "expected": {"value": false, "variant": "off", "reason": "DEFAULT", "error_code": null, "metadata": {}}},
    {"name": "invalid-attribute-leading-zero", "flag": "eq", "context": {"key": "u", "attr": "01.2.3"}, "default": false,
     "expected": {"value": false, "variant": "off", "reason": "DEFAULT", "error_code": null, "metadata": {}}},
    {"name": "invalid-attribute-trailing-newline", "flag": "eq", "context": {"key": "u", "attr": "1.2.3\n"}, "default": false,
     "expected": {"value": false, "variant": "off", "reason": "DEFAULT", "error_code": null, "metadata": {}}},
    {"name": "number-attribute", "flag": "eq", "context": {"key": "u", "attr": 1.2}, "default": false,
     "expected": {"value": false, "variant": "off", "reason": "DEFAULT", "error_code": null, "metadata": {}}},
    {"name": "invalid-clause-value-never-matches", "flag": "invalid-value", "context": {"key": "u", "attr": "1.2.3"}, "default": false,
     "expected": {"value": false, "variant": "off", "reason": "DEFAULT", "error_code": null, "metadata": {}}}
  ]
}
