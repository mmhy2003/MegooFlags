        "prerequisites": [], "targets": [],
        "rules": [{"description": "", "clauses": [{"attribute": "attr", "operator": "after", "values": ["2026-01-01T02:00:00+02:00"], "negate": false}], "serve": {"variation": "on"}}],
        "fallthrough": {"variation": "off"}},
