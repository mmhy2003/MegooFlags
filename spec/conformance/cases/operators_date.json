        "variations": [{"key": "on", "value": true}, {"key": "off", "value": false}], "off_variation": "off",
        "prerequisites": [], "targets": [],
        "rules": [{"description": "", "clauses": [{"attribute": "attr", "operator": "before", "values": ["2026-01-01T00:00:00.0019Z"], "negate": false}], "serve": {"variation": "on"}}],
        "fallthrough": {"variation": "off"}}
    },
    "segments": {}
  },
  "tests": [
