        "prerequisites": [], "targets": [],
        "rules": [{"description": "", "clauses": [{"attribute": "attr", "operator": "before", "values": ["2026-01-01T00:00:00Z"], "negate": false}], "serve": {"variation": "on"}}],
        "fallthrough": {"variation": "off"}},
      "after": {"key": "after", "type": "boolean", "enabled": true, "version": 1,
        "variations": [{"key": "on", "value": true}, {"key": "off", "value": false}], "off_variation": "off",
        "prerequisites": [], "targets": [],
        "rules": [{"description": "", "clauses": [{"attribute": "attr", "operator": "after", "values": ["2026-01-01T00:00:00.000Z"], "negate": false}], "serve": {"variation": "on"}}],
