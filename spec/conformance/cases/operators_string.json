{
  "schema_version": 1,
  "description": "contains, starts_with and ends_with: case-sensitive, string attributes only. Each flag serves on from a rule on attr and falls through to off.",
  "ruleset": {
    "schema_version": 1,
    "project": "conformance",
    "environment": "test",
    "flags": {
      "contains": {"key": "contains", "type": "boolean", "enabled": true, "version": 1,
        "variations": [{"key": "on", "value": true}, {"key": "off", "value": false}], "off_variation": "off",
        "prerequisites": [], "targets": [],
        "rules": [{"description": "", "clauses": [{"attribute": "attr", "operator": "contains", "values": ["beta"], "negate": false}], "serve": {"variation": "on"}}],
        "fallthrough": {"variation": "off"}},
      "contains-digit": {"key": "contains-digit", "type": "boolean", "enabled": true, "version": 1,
        "variations": [{"key": "on", "value": true}, {"key": "off", "value": false}], "off_variation": "off",
        "prerequisites": [], "targets": [],
        "rules": [{"description": "", "clauses": [{"attribute": "attr", "operator": "contains", "values": ["5"], "negate": false}], "serve": {"variation": "on"}}],
        "fallthrough": {"variation": "off"}},
      "starts-with": {"key": "starts-with", "type": "boolean", "enabled": true, "version": 1,
        "variations": [{"key": "on", "value": true}, {"key": "off", "value": false}], "off_variation": "off",
        "prerequisites": [], "targets": [],
        "rules": [{"description": "", "clauses": [{"attribute": "attr", "operator": "starts_with", "values": ["pre"], "negate": false}], "serve": {"variation": "on"}}],
        "fallthrough": {"variation": "off"}},
      "starts-with-digit": {"key": "starts-with-digit", "type": "boolean", "enabled": true, "version": 1,
        "variations": [{"key": "on", "value": true}, {"key": "off", "value": false}], "off_variation": "off",
        "prerequisites": [], "targets": [],
        "rules": [{"description": "", "clauses": [{"attribute": "attr", "operator": "starts_with", "values": ["1"], "negate": false}], "serve": {"variation": "on"}}],
        "fallthrough": {"variation": "off"}},
      "ends-with": {"key": "ends-with", "type": "boolean", "enabled": true, "version": 1,
        "variations": [{"key": "on", "value": true}, {"key": "off", "value": false}], "off_variation": "off",
        "prerequisites": [], "targets": [],
        "rules": [{"description": "", "clauses": [{"attribute": "attr", "operator": "ends_with", "values": ["@example.com"], "negate": false}], "serve": {"variation": "on"}}],
        "fallthrough": {"variation": "off"}},
      "ends-with-digit": {"key": "ends-with-digit", "type": "boolean", "enabled": true, "version": 1,
        "variations": [{"key": "on", "value": true}, {"key": "off", "value": false}], "off_variation": "off",
        "prerequisites": [], "targets": [],
        "rules": [{"description": "", "clauses": [{"attribute": "attr", "operator": "ends_with", "values": ["3"], "negate": false}], "serve": {"variation": "on"}}],
        "fallthrough": {"variation": "off"}}
    },
    "segments": {}
  },
  "tests": [
    {"name": "contains-hit", "flag": "contains", "context": {"key": "u", "attr": "a-beta-b"}, "default": false,
     "expected": {"value": true, "variant": "on", "reason": "TARGETING_MATCH", "error_code": null, "metadata": {"rule_index": 0}}},
    {"name": "contains-miss", "flag": "contains", "context": {"key": "u", "attr": "alpha"}, "default": false,
     "expected": {"value": false, "variant": "off", "reason": "DEFAULT", "error_code": null, "metadata": {}}},
    {"name": "contains-case-sensitive", "flag": "contains", "context": {"key": "u", "attr": "BETA"}, "default": false,
     "expected": {"value": false, "variant": "off", "reason": "DEFAULT", "error_code": null, "metadata": {}}},
    {"name": "contains-number-attribute", "flag": "contains-digit", "context": {"key": "u", "attr": 15}, "default": false,
     "expected": {"value": false, "variant": "off", "reason": "DEFAULT", "error_code": null, "metadata": {}}},
    {"name": "starts-with-hit", "flag": "starts-with", "context": {"key": "u", "attr": "prefix"}, "default": false,
     "expected": {"value": true, "variant": "on", "reason": "TARGETING_MATCH", "error_code": null, "metadata": {"rule_index": 0}}},
    {"name": "starts-with-miss", "flag": "starts-with", "context": {"key": "u", "attr": "apre"}, "default": false,
     "expected": {"value": false, "variant": "off", "reason": "DEFAULT", "error_code": null, "metadata": {}}},
    {"name": "starts-with-case-sensitive", "flag": "starts-with", "context": {"key": "u", "attr": "Prefix"}, "default": false,
     "expected": {"value": false, "variant": "off", "reason": "DEFAULT", "error_code": null, "metadata": {}}},
    {"name": "starts-with-number-attribute", "flag": "starts-with-digit", "context": {"key": "u", "attr": 123}, "default": false,
     "expected": {"value": false, "variant": "off", "reason": "DEFAULT", "error_code": null, "metadata": {}}},
    {"name": "ends-with-hit", "flag": "ends-with", "context": {"key": "u", "attr": "a@example.com"}, "default": false,
     "expected": {"value": true, "variant": "on", "reason": "TARGETING_MATCH", "error_code": null, "metadata": {"rule_index": 0}}},
    {"name": "ends-with-miss", "flag": "ends-with", "context": {"key": "u", "attr": "a@example.org"}, "default": false,
     "expected": {"value": false, "variant": "off", "reason": "DEFAULT", "error_code": null, "metadata": {}}},
    {"name": "ends-with-case-sensitive", "flag": "ends-with", "context": {"key": "u", "attr": "A@EXAMPLE.COM"}, "default": false,
     "expected": {"value": false, "variant": "off", "reason": "DEFAULT", "error_code": null, "metadata": {}}},
    {"name": "ends-with-number-attribute", "flag": "ends-with-digit", "context": {"key": "u", "attr": 123}, "default": false,
     "expected": {"value": false, "variant": "off", "reason": "DEFAULT", "error_code": null, "metadata": {}}}
  ]
}
