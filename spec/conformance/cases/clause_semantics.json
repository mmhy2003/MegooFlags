{
  "schema_version": 1,
  "description": "Clause semantics: negation, missing and null attributes, wrong types, arrays, AND across clauses, OR across values, and rule order. The boolean flags serve on from their first rule and fall through to off.",
  "ruleset": {
    "schema_version": 1,
    "project": "conformance",
    "environment": "test",
    "flags": {
      "negate": {"key": "negate", "type": "boolean", "enabled": true, "version": 1,
        "variations": [{"key": "on", "value": true}, {"key": "off", "value": false}], "off_variation": "off",
        "prerequisites": [], "targets": [],
        "rules": [{"description": "", "clauses": [{"attribute": "country", "operator": "in", "values": ["us"], "negate": true}], "serve": {"variation": "on"}}],
        "fallthrough": {"variation": "off"}},
      "negate-lt": {"key": "negate-lt", "type": "boolean", "enabled": true, "version": 1,
        "variations": [{"key": "on", "value": true}, {"key": "off", "value": false}], "off_variation": "off",
        "prerequisites": [], "targets": [],
        "rules": [{"description": "", "clauses": [{"attribute": "attr", "operator": "lt", "values": [10], "negate": true}], "serve": {"variation": "on"}}],
        "fallthrough": {"variation": "off"}},
      "array": {"key": "array", "type": "boolean", "enabled": true, "version": 1,
        "variations": [{"key": "on", "value": true}, {"key": "off", "value": false}], "off_variation": "off",
        "prerequisites": [], "targets": [],
        "rules": [{"description": "", "clauses": [{"attribute": "groups", "operator": "in", "values": ["beta"], "negate": false}], "serve": {"variation": "on"}}],
        "fallthrough": {"variation": "off"}},
      "array-negate": {"key": "array-negate", "type": "boolean", "enabled": true, "version": 1,
        "variations": [{"key": "on", "value": true}, {"key": "off", "value": false}], "off_variation": "off",
        "prerequisites": [], "targets": [],
        "rules": [{"description": "", "clauses": [{"attribute": "groups", "operator": "in", "values": ["beta"], "negate": true}], "serve": {"variation": "on"}}],
        "fallthrough": {"variation": "off"}},
      "and": {"key": "and", "type": "boolean", "enabled": true, "version": 1,
        "variations": [{"key": "on", "value": true}, {"key": "off", "value": false}], "off_variation": "off",
        "prerequisites": [], "targets": [],
        "rules": [{"description": "", "clauses": [
          {"attribute": "country", "operator": "in", "values": ["us"], "negate": false},
          {"attribute": "plan", "operator": "in", "values": ["pro"], "negate": false}
        ], "serve": {"variation": "on"}}],
        "fallthrough": {"variation": "off"}},
      "or": {"key": "or", "type": "boolean", "enabled": true, "version": 1,
        "variations": [{"key": "on", "value": true}, {"key": "off", "value": false}], "off_variation": "off",
        "prerequisites": [], "targets": [],
        "rules": [{"description": "", "clauses": [{"attribute": "attr", "operator": "starts_with", "values": ["a", "b"], "negate": false}], "serve": {"variation": "on"}}],
        "fallthrough": {"variation": "off"}},
      "first": {"key": "first", "type": "string", "enabled": true, "version": 1,
        "variations": [{"key": "r0", "value": "r0"}, {"key": "r1", "value": "r1"}, {"key": "fall", "value": "fall"}],
        "off_variation": "fall",
        "prerequisites": [], "targets": [],
        "rules": [
          {"description": "pro plan", "clauses": [{"attribute": "plan", "operator": "in", "values": ["pro"], "negate": false}], "serve": {"variation": "r0"}},
          {"description": "us", "clauses": [{"attribute": "country", "operator": "in", "values": ["us"], "negate": false}], "serve": {"variation": "r1"}}
        ],
        "fallthrough": {"variation": "fall"}}
    },
    "segments": {}
  },
  "tests": [
    {"name": "negate-inverts-miss", "flag": "negate", "context": {"key": "u", "country": "mx"}, "default": false,
     "expected": {"value": true, "variant": "on", "reason": "TARGETING_MATCH", "error_code": null, "metadata": {"rule_index": 0}}},
    {"name": "negate-inverts-hit", "flag": "negate", "context": {"key": "u", "country": "us"}, "default": false,
     "expected": {"value": false, "variant": "off", "reason": "DEFAULT", "error_code": null, "metadata": {}}},
    {"name": "missing-attribute-with-negate-is-false", "flag": "negate", "context": {"key": "u"}, "default": false,
     "expected": {"value": false, "variant": "off", "reason": "DEFAULT", "error_code": null, "metadata": {}}},
    {"name": "null-attribute-counts-as-missing", "flag": "negate", "context": {"key": "u", "country": null}, "default": false,
     "expected": {"value": false, "variant": "off", "reason": "DEFAULT", "error_code": null, "metadata": {}}},
    {"name": "wrong-type-with-negate-is-true", "flag": "negate", "context": {"key": "u", "country": 5}, "default": false,
     "expected": {"value": true, "variant": "on", "reason": "TARGETING_MATCH", "error_code": null, "metadata": {"rule_index": 0}}},
    {"name": "string-for-lt-with-negate-is-true", "flag": "negate-lt", "context": {"key": "u", "attr": "abc"}, "default": false,
     "expected": {"value": true, "variant": "on", "reason": "TARGETING_MATCH", "error_code": null, "metadata": {"rule_index": 0}}},
    {"name": "negate-lt-in-range", "flag": "negate-lt", "context": {"key": "u", "attr": 5}, "default": false,
     "expected": {"value": false, "variant": "off", "reason": "DEFAULT", "error_code": null, "metadata": {}}},
    {"name": "array-any-element-matches", "flag": "array", "context": {"key": "u", "groups": ["alpha", "beta"]}, "default": false,
     "expected": {"value": true, "variant": "on", "reason": "TARGETING_MATCH", "error_code": null, "metadata": {"rule_index": 0}}},
    {"name": "array-no-element-matches", "flag": "array", "context": {"key": "u", "groups": ["alpha"]}, "default": false,
     "expected": {"value": false, "variant": "off", "reason": "DEFAULT", "error_code": null, "metadata": {}}},
    {"name": "empty-array-matches-nothing", "flag": "array", "context": {"key": "u", "groups": []}, "default": false,
     "expected": {"value": false, "variant": "off", "reason": "DEFAULT", "error_code": null, "metadata": {}}},
    {"name": "array-object-element-skipped-other-matches", "flag": "array", "context": {"key": "u", "groups": [{"x": 1}, "beta"]}, "default": false,
     "expected": {"value": true, "variant": "on", "reason": "TARGETING_MATCH", "error_code": null, "metadata": {"rule_index": 0}}},
    {"name": "array-object-element-is-wrong-type", "flag": "array", "context": {"key": "u", "groups": [{"beta": true}]}, "default": false,
     "expected": {"value": false, "variant": "off", "reason": "DEFAULT", "error_code": null, "metadata": {}}},
    {"name": "scalar-attribute-against-array-clause", "flag": "array", "context": {"key": "u", "groups": "beta"}, "default": false,
     "expected": {"value": true, "variant": "on", "reason": "TARGETING_MATCH", "error_code": null, "metadata": {"rule_index": 0}}},
    {"name": "empty-array-with-negate-is-true", "flag": "array-negate", "context": {"key": "u", "groups": []}, "default": false,
     "expected": {"value": true, "variant": "on", "reason": "TARGETING_MATCH", "error_code": null, "metadata": {"rule_index": 0}}},
    {"name": "array-with-negate-element-matches", "flag": "array-negate", "context": {"key": "u", "groups": ["alpha", "beta"]}, "default": false,
     "expected": {"value": false, "variant": "off", "reason": "DEFAULT", "error_code": null, "metadata": {}}},
    {"name": "array-with-negate-no-element-matches", "flag": "array-negate", "context": {"key": "u", "groups": ["alpha"]}, "default": false,
     "expected": {"value": true, "variant": "on", "reason": "TARGETING_MATCH", "error_code": null, "metadata": {"rule_index": 0}}},
    {"name": "and-all-clauses-match", "flag": "and", "context": {"key": "u", "country": "us", "plan": "pro"}, "default": false,
     "expected": {"value": true, "variant": "on", "reason": "TARGETING_MATCH", "error_code": null, "metadata": {"rule_index": 0}}},
    {"name": "and-one-clause-fails", "flag": "and", "context": {"key": "u", "country": "us", "plan": "free"}, "default": false,
     "expected": {"value": false, "variant": "off", "reason": "DEFAULT", "error_code": null, "metadata": {}}},
    {"name": "and-one-attribute-missing", "flag": "and", "context": {"key": "u", "country": "us"}, "default": false,
     "expected": {"value": false, "variant": "off", "reason": "DEFAULT", "error_code": null, "metadata": {}}},
    {"name": "or-first-value", "flag": "or", "context": {"key": "u", "attr": "alice"}, "default": false,
     "expected": {"value": true, "variant": "on", "reason": "TARGETING_MATCH", "error_code": null, "metadata": {"rule_index": 0}}},
    {"name": "or-second-value", "flag": "or", "context": {"key": "u", "attr": "bob"}, "default": false,
     "expected": {"value": true, "variant": "on", "reason": "TARGETING_MATCH", "error_code": null, "metadata": {"rule_index": 0}}},
    {"name": "or-no-value", "flag": "or", "context": {"key": "u", "attr": "carol"}, "default": false,
     "expected": {"value": false, "variant": "off", "reason": "DEFAULT", "error_code": null, "metadata": {}}},
    {"name": "first-matching-rule-wins", "flag": "first", "context": {"key": "u", "plan": "pro", "country": "us"}, "default": "x",
     "expected": {"value": "r0", "variant": "r0", "reason": "TARGETING_MATCH", "error_code": null, "metadata": {"rule_index": 0}}},
    {"name": "second-rule-matches", "flag": "first", "context": {"key": "u", "country": "us"}, "default": "x",
     "expected": {"value": "r1", "variant": "r1", "reason": "TARGETING_MATCH", "error_code": null, "metadata": {"rule_index": 1}}},
    {"name": "no-rule-matches", "flag": "first", "context": {"key": "u"}, "default": "x",
     "expected": {"value": "fall", "variant": "fall", "reason": "DEFAULT", "error_code": null, "metadata": {}}}
  ]
}
