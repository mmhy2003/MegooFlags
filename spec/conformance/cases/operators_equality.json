{
  "schema_version": 1,
  "description": "in and not_in: JSON equality, where 1 == 1.0 but \"1\" != 1 and true != 1. Each flag serves on from a rule on attr and falls through to off.",
  "ruleset": {
    "schema_version": 1,
    "project": "conformance",
    "environment": "test",
    "flags": {
      "in-string": {"key": "in-string", "type": "boolean", "enabled": true, "version": 1,
        "variations": [{"key": "on", "value": true}, {"key": "off", "value": false}], "off_variation": "off",
        "prerequisites": [], "targets": [],
        "rules": [{"description": "", "clauses": [{"attribute": "attr", "operator": "in", "values": ["us", "ca"], "negate": false}], "serve": {"variation": "on"}}],
        "fallthrough": {"variation": "off"}},
      "in-number": {"key": "in-number", "type": "boolean", "enabled": true, "version": 1,
        "variations": [{"key": "on", "value": true}, {"key": "off", "value": false}], "off_variation": "off",
        "prerequisites": [], "targets": [],
        "rules": [{"description": "", "clauses": [{"attribute": "attr", "operator": "in", "values": [1], "negate": false}], "serve": {"variation": "on"}}],
        "fallthrough": {"variation": "off"}},
      "in-bool": {"key": "in-bool", "type": "boolean", "enabled": true, "version": 1,
        "variations": [{"key": "on", "value": true}, {"key": "off", "value": false}], "off_variation": "off",
        "prerequisites": [], "targets": [],
        "rules": [{"description": "", "clauses": [{"attribute": "attr", "operator": "in", "values": [true], "negate": false}], "serve": {"variation": "on"}}],
        "fallthrough": {"variation": "off"}},
      "not-in": {"key": "not-in", "type": "boolean", "enabled": true, "version": 1,
        "variations": [{"key": "on", "value": true}, {"key": "off", "value": false}], "off_variation": "off",
        "prerequisites": [], "targets": [],
        "rules": [{"description": "", "clauses": [{"attribute": "attr", "operator": "not_in", "values": ["us", "ca"], "negate": false}], "serve": {"variation": "on"}}],
        "fallthrough": {"variation": "off"}},
      "not-in-number": {"key": "not-in-number", "type": "boolean", "enabled": true, "version": 1,
        "variations": [{"key": "on", "value": true}, {"key": "off", "value": false}], "off_variation": "off",
        "prerequisites": [], "targets": [],
        "rules": [{"description": "", "clauses": [{"attribute": "attr", "operator": "not_in", "values": [1], "negate": false}], "serve": {"variation": "on"}}],
        "fallthrough": {"variation": "off"}}
    },
    "segments": {}
  },
  "tests": [
    {"name": "in-string-hit", "flag": "in-string", "context": {"key": "u", "attr": "us"}, "default": false,
     "expected": {"value": true, "variant": "on", "reason": "TARGETING_MATCH", "error_code": null, "metadata": {"rule_index": 0}}},
    {"name": "in-string-second-value-hit", "flag": "in-string", "context": {"key": "u", "attr": "ca"}, "default": false,
     "expected": {"value": true, "variant": "on", "reason": "TARGETING_MATCH", "error_code": null, "metadata": {"rule_index": 0}}},
    {"name": "in-string-miss", "flag": "in-string", "context": {"key": "u", "attr": "mx"}, "default": false,
     "expected": {"value": false, "variant": "off", "reason": "DEFAULT", "error_code": null, "metadata": {}}},
    {"name": "in-string-case-sensitive", "flag": "in-string", "context": {"key": "u", "attr": "US"}, "default": false,
     "expected": {"value": false, "variant": "off", "reason": "DEFAULT", "error_code": null, "metadata": {}}},
    {"name": "in-number-int", "flag": "in-number", "context": {"key": "u", "attr": 1}, "default": false,
     "expected": {"value": true, "variant": "on", "reason": "TARGETING_MATCH", "error_code": null, "metadata": {"rule_index": 0}}},
    {"name": "in-number-float-equals-int", "flag": "in-number", "context": {"key": "u", "attr": 1.0}, "default": false,
     "expected": {"value": true, "variant": "on", "reason": "TARGETING_MATCH", "error_code": null, "metadata": {"rule_index": 0}}},
    {"name": "in-number-string-is-not-number", "flag": "in-number", "context": {"key": "u", "attr": "1"}, "default": false,
     "expected": {"value": false, "variant": "off", "reason": "DEFAULT", "error_code": null, "metadata": {}}},
    {"name": "in-number-true-is-not-1", "flag": "in-number", "context": {"key": "u", "attr": true}, "default": false,
     "expected": {"value": false, "variant": "off", "reason": "DEFAULT", "error_code": null, "metadata": {}}},
    {"name": "in-number-miss", "flag": "in-number", "context": {"key": "u", "attr": 2}, "default": false,
     "expected": {"value": false, "variant": "off", "reason": "DEFAULT", "error_code": null, "metadata": {}}},
    {"name": "in-bool-hit", "flag": "in-bool", "context": {"key": "u", "attr": true}, "default": false,
     "expected": {"value": true, "variant": "on", "reason": "TARGETING_MATCH", "error_code": null, "metadata": {"rule_index": 0}}},
    {"name": "in-bool-1-is-not-true", "flag": "in-bool", "context": {"key": "u", "attr": 1}, "default": false,
     "expected": {"value": false, "variant": "off", "reason": "DEFAULT", "error_code": null, "metadata": {}}},
    {"name": "in-bool-string-is-not-bool", "flag": "in-bool", "context": {"key": "u", "attr": "true"}, "default": false,
     "expected": {"value": false, "variant": "off", "reason": "DEFAULT", "error_code": null, "metadata": {}}},
    {"name": "not-in-hit", "flag": "not-in", "context": {"key": "u", "attr": "mx"}, "default": false,
     "expected": {"value": true, "variant": "on", "reason": "TARGETING_MATCH", "error_code": null, "metadata": {"rule_index": 0}}},
    {"name": "not-in-miss", "flag": "not-in", "context": {"key": "u", "attr": "us"}, "default": false,
     "expected": {"value": false, "variant": "off", "reason": "DEFAULT", "error_code": null, "metadata": {}}},
    {"name": "not-in-array-one-unlisted-element", "flag": "not-in", "context": {"key": "u", "attr": ["us", "mx"]}, "default": false,
     "expected": {"value": true, "variant": "on", "reason": "TARGETING_MATCH", "error_code": null, "metadata": {"rule_index": 0}}},
    {"name": "not-in-array-all-listed", "flag": "not-in", "context": {"key": "u", "attr": ["us", "ca"]}, "default": false,
     "expected": {"value": false, "variant": "off", "reason": "DEFAULT", "error_code": null, "metadata": {}}},
    {"name": "not-in-float-equals-int", "flag": "not-in-number", "context": {"key": "u", "attr": 1.0}, "default": false,
     "expected": {"value": false, "variant": "off", "reason": "DEFAULT", "error_code": null, "metadata": {}}},
    {"name": "not-in-string-is-not-number", "flag": "not-in-number", "context": {"key": "u", "attr": "1"}, "default": false,
     "expected": {"value": true, "variant": "on", "reason": "TARGETING_MATCH", "error_code": null, "metadata": {"rule_index": 0}}},
    {"name": "not-in-object-element-is-wrong-type", "flag": "not-in", "context": {"key": "u", "attr": [{"a": 1}]}, "default": false,
     "expected": {"value": false, "variant": "off", "reason": "DEFAULT", "error_code": null, "metadata": {}}}
  ]
}
