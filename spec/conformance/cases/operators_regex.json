{
  "schema_version": 1,
  "description": "matches: unanchored search with portable RE2/Python syntax and ASCII semantics; a pattern that does not compile never matches. Each flag serves on from a rule on attr and falls through to off.",
  "ruleset": {
    "schema_version": 1,
    "project": "conformance",
    "environment": "test",
    "flags": {
      "unanchored": {"key": "unanchored", "type": "boolean", "enabled": true, "version": 1,
        "variations": [{"key": "on", "value": true}, {"key": "off", "value": false}], "off_variation": "off",
        "prerequisites": [], "targets": [],
        "rules": [{"description": "", "clauses": [{"attribute": "attr", "operator": "matches", "values": ["b"], "negate": false}], "serve": {"variation": "on"}}],
        "fallthrough": {"variation": "off"}},
      "anchored": {"key": "anchored", "type": "boolean", "enabled": true, "version": 1,
        "variations": [{"key": "on", "value": true}, {"key": "off", "value": false}], "off_variation": "off",
        "prerequisites": [], "targets": [],
        "rules": [{"description": "", "clauses": [{"attribute": "attr", "operator": "matches", "values": ["^ab$"], "negate": false}], "serve": {"variation": "on"}}],
        "fallthrough": {"variation": "off"}},
      "digit": {"key": "digit", "type": "boolean", "enabled": true, "version": 1,
        "variations": [{"key": "on", "value": true}, {"key": "off", "value": false}], "off_variation": "off",
        "prerequisites": [], "targets": [],
        "rules": [{"description": "", "clauses": [{"attribute": "attr", "operator": "matches", "values": ["\\d"], "negate": false}], "serve": {"variation": "on"}}],
        "fallthrough": {"variation": "off"}},
      "invalid": {"key": "invalid", "type": "boolean", "enabled": true, "version": 1,
        "variations": [{"key": "on", "value": true}, {"key": "off", "value": false}], "off_variation": "off",
        "prerequisites": [], "targets": [],
        "rules": [{"description": "", "clauses": [{"attribute": "attr", "operator": "matches", "values": ["("], "negate": false}], "serve": {"variation": "on"}}],
        "fallthrough": {"variation": "off"}},
      "invalid-and-valid": {"key": "invalid-and-valid", "type": "boolean", "enabled": true, "version": 1,
        "variations": [{"key": "on", "value": true}, {"key": "off", "value": false}], "off_variation": "off",
        "prerequisites": [], "targets": [],
        "rules": [{"description": "", "clauses": [{"attribute": "attr", "operator": "matches", "values": ["(", "^a"], "negate": false}], "serve": {"variation": "on"}}],
        "fallthrough": {"variation": "off"}},
      "on-number": {"key": "on-number", "type": "boolean", "enabled": true, "version": 1,
        "variations": [{"key": "on", "value": true}, {"key": "off", "value": false}], "off_variation": "off",
        "prerequisites": [], "targets": [],
        "rules": [{"description": "", "clauses": [{"attribute": "attr", "operator": "matches", "values": ["1"], "negate": false}], "serve": {"variation": "on"}}],
        "fallthrough": {"variation": "off"}}
    },
    "segments": {}
  },
  "tests": [
    {"name": "unanchored-hit", "flag": "unanchored", "context": {"key": "u", "attr": "abc"}, "default": false,
     "expected": {"value": true, "variant": "on", "reason": "TARGETING_MATCH", "error_code": null, "metadata": {"rule_index": 0}}},
    {"name": "unanchored-miss", "flag": "unanchored", "context": {"key": "u", "attr": "xyz"}, "default": false,
     "expected": {"value": false, "variant": "off", "reason": "DEFAULT", "error_code": null, "metadata": {}}},
    {"name": "anchored-hit", "flag": "anchored", "context": {"key": "u", "attr": "ab"}, "default": false,
     "expected": {"value": true, "variant": "on", "reason": "TARGETING_MATCH", "error_code": null, "metadata": {"rule_index": 0}}},
    {"name": "anchored-trailing-text", "flag": "anchored", "context": {"key": "u", "attr": "abc"}, "default": false,
     "expected": {"value": false, "variant": "off", "reason": "DEFAULT", "error_code": null, "metadata": {}}},
    {"name": "anchored-leading-text", "flag": "anchored", "context": {"key": "u", "attr": "xab"}, "default": false,
     "expected": {"value": false, "variant": "off", "reason": "DEFAULT", "error_code": null, "metadata": {}}},
    {"name": "ascii-digit-hit", "flag": "digit", "context": {"key": "u", "attr": "a3"}, "default": false,
     "expected": {"value": true, "variant": "on", "reason": "TARGETING_MATCH", "error_code": null, "metadata": {"rule_index": 0}}},
    {"name": "arabic-indic-digit-miss", "flag": "digit", "context": {"key": "u", "attr": "٣"}, "default": false,
     "expected": {"value": false, "variant": "off", "reason": "DEFAULT", "error_code": null, "metadata": {}}},
    {"name": "invalid-pattern-never-matches", "flag": "invalid", "context": {"key": "u", "attr": "("}, "default": false,
     "expected": {"value": false, "variant": "off", "reason": "DEFAULT", "error_code": null, "metadata": {}}},
    {"name": "invalid-pattern-never-matches-other", "flag": "invalid", "context": {"key": "u", "attr": "abc"}, "default": false,
     "expected": {"value": false, "variant": "off", "reason": "DEFAULT", "error_code": null, "metadata": {}}},
    {"name": "valid-value-still-matches", "flag": "invalid-and-valid", "context": {"key": "u", "attr": "abc"}, "default": false,
     "expected": {"value": true, "variant": "on", "reason": "TARGETING_MATCH", "error_code": null, "metadata": {"rule_index": 0}}},
    {"name": "number-attribute-miss", "flag": "on-number", "context": {"key": "u", "attr": 1}, "default": false,
     "expected": {"value": false, "variant": "off", "reason": "DEFAULT", "error_code": null, "metadata": {}}}
  ]
}
