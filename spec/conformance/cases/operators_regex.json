{
  "schema_version": 1,
  "description": "matches: unanchored search with portable RE2/Python syntax and ASCII semantics (case-insensitive matching folds ASCII letters only, \\s includes \\v, and $ also matches before a final newline as in Python); a pattern that does not compile never matches. Each flag serves on from a rule on attr and falls through to off. `.` excludes only a newline and matches one code point; `\\s`, `\\w` and `\\b` are ASCII-only; `(?m)`, `(?s)` and scoped `(?i:…)` flags, named groups, `\\A` and a `[` inside a class behave as in Python.",
  "ruleset": {
    "schema_version": 1,
    "project": "conformance",
    "environment": "test",
    "flags": {
      "unanchored": {"key": "unanchored", "type": "boolean", "enabled": true, "version": 1,
        "variations": [{"key": "on", "value": true}, {"key": "off", "value": false}], "off_variation": "off",
        "prerequisites": [], "targets": [],
        "rules": [{"description": "", "clauses": [{"attribute": "attr", "operator": "matches", "values": ["b"], "negate": false}], "serve": {"variation": "on"}}],
        "fallthrough": {"variation": "off"}},
      "anchored": {"key": "anchored", "type": "boolean", "enabled": true, "version": 1,
        "variations": [{"key": "on", "value": true}, {"key": "off", "value": false}], "off_variation": "off",
