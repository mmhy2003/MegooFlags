{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MegooFlags Helm chart values",
  "type": "object",
  "properties": {
    "role": {
      "type": "string",
      "enum": [
        "standalone",
        "control-plane",
        "worker"
      ]
    },
    "image": {
      "type": "object",
      "properties": {
        "registry": {
          "type": "string"
        },
        "tag": {
          "type": "string"
        },
        "pullPolicy": {
          "type": "string",
          "enum": [
            "Always",
            "IfNotPresent",
            "Never"
          ]
        }
      }
    },
    "imagePullSecrets": {
      "type": "array"
    },
    "secretKey": {
      "type": "string"
    },
    "existingSecret": {
      "type": "string"
    },
    "config": {
      "type": "object",
      "properties": {},
      "additionalProperties": {
        "type": [
          "string",
          "number",
          "boolean"
        ]
      }
    },
    "api": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "resources": {
          "type": "object"
        },
        "extraEnv": {
          "type": "array"
        },
        "podAnnotations": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        }
      }
    },
    "web": {
      "type": "object",
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "resources": {
          "type": "object"
        },
        "extraEnv": {
          "type": "array"
        },
        "podAnnotations": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        }
      }
    },
    "migrate": {
      "type": "object",
      "properties": {
        "annotations": {
          "type": "object"
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "postgresql": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "string"
        },
        "password": {
          "type": "string"
        },
        "persistence": {
          "type": "object",
          "properties": {
            "size": {
              "type": "string"
            },
            "storageClass": {
              "type": "string"
            }
          }
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "externalDatabase": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        }
      }
    },
    "valkey": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "image": {
          "type": "string"
        },
        "resources": {
          "type": "object"
        }
      }
    },
    "externalValkey": {
      "type": "object",
      "properties": {
        "url": {
          "type": "string"
        }
      }
    },
    "worker": {
      "type": "object",
      "properties": {
        "controlPlaneUrl": {
          "type": "string"
        },
        "nodeTokens": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "replicas": {
          "type": "integer",
          "minimum": 0
        },
        "controlPlaneInsecure": {
          "type": "boolean"
        },
        "controlPlaneCa": {
          "type": "object",
          "properties": {
            "configMap": {
              "type": "string"
            },
            "secret": {
              "type": "string"
            },
            "key": {
              "type": "string"
            }
          }
        },
        "persistence": {
          "type": "object",
          "properties": {
            "size": {
              "type": "string"
            },
            "storageClass": {
              "type": "string"
            }
          }
        },
        "resources": {
          "type": "object"
        },
        "extraEnv": {
          "type": "array"
        },
        "podAnnotations": {
          "type": "object"
        },
        "nodeSelector": {
          "type": "object"
        },
        "tolerations": {
          "type": "array"
        },
        "affinity": {
          "type": "object"
        }
      }
    },
    "ingress": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "className": {
          "type": "string"
        },
        "annotations": {
          "type": "object"
        },
        "host": {
          "type": "string"
        },
        "tls": {
          "type": "array"
        }
      }
    },
    "httpRoute": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "parentRefs": {
          "type": "array"
        },
        "hostnames": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "apiResponseHeaders": {
          "type": "boolean"
        },
        "timeouts": {
          "type": "object",
          "properties": {
            "request": {
              "type": "string"
            }
          }
        }
      }
    },
    "metrics": {
      "type": "object",
      "properties": {
        "serviceMonitor": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "interval": {
              "type": "string"
            },
            "labels": {
              "type": "object"
            }
          }
        }
      }
    }
  }
}
