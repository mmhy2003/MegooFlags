{
  "realm": "megooflags-test",
  "enabled": true,
  "sslRequired": "none",
  "groups": [
    { "name": "flag-admins", "path": "/flag-admins" },
    { "name": "viewers", "path": "/viewers" }
  ],
  "users": [
    {
      "username": "alice",
      "email": "alice@example.com",
      "firstName": "Alice",
      "lastName": "Admin",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "Keycloak-test-1", "temporary": false }],
      "groups": ["/flag-admins"]
    },
    {
      "username": "bob",
      "email": "bob@example.com",
      "firstName": "Bob",
      "lastName": "Viewer",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "Keycloak-test-1", "temporary": false }],
      "groups": ["/viewers"]
    },
    {
      "username": "carol",
      "email": "carol@example.com",
      "firstName": "Carol",
      "lastName": "Local",
      "enabled": true,
      "emailVerified": true,
      "credentials": [{ "type": "password", "value": "Keycloak-test-1", "temporary": false }],
      "groups": []
    }
  ],
  "clients": [
    {
      "clientId": "megooflags-oidc",
      "name": "MegooFlags (OIDC)",
      "protocol": "openid-connect",
      "enabled": true,
      "publicClient": false,
      "clientAuthenticatorType": "client-secret",
      "secret": "megooflags-oidc-secret",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "redirectUris": ["http://megooflags.test/*"],
      "attributes": { "pkce.code.challenge.method": "S256" },
      "protocolMappers": [
        {
          "name": "groups",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-group-membership-mapper",
          "config": {
            "claim.name": "groups",
            "full.path": "false",
            "id.token.claim": "true",
            "access.token.claim": "true",
            "userinfo.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "http://megooflags.test/api/auth/sso/kc-saml/saml/metadata",
      "name": "MegooFlags (SAML)",
      "protocol": "saml",
      "enabled": true,
      "frontchannelLogout": false,
      "redirectUris": ["http://megooflags.test/api/auth/sso/kc-saml/saml/acs"],
      "attributes": {
        "saml_assertion_consumer_url_post": "http://megooflags.test/api/auth/sso/kc-saml/saml/acs",
        "saml.assertion.signature": "true",
        "saml.server.signature": "true",
        "saml.client.signature": "false",
        "saml.encrypt": "false",
        "saml.authnstatement": "true",
        "saml.signature.algorithm": "RSA_SHA256",
        "saml_force_name_id_format": "true",
        "saml_name_id_format": "email"
      },
      "protocolMappers": [
        {
          "name": "email",
          "protocol": "saml",
          "protocolMapper": "saml-user-property-mapper",
          "config": {
            "user.attribute": "email",
            "attribute.name": "email",
            "attribute.nameformat": "Basic"
          }
        },
        {
          "name": "groups",
          "protocol": "saml",
          "protocolMapper": "saml-group-membership-mapper",
          "config": {
            "attribute.name": "groups",
            "attribute.nameformat": "Basic",
            "full.path": "false",
            "single": "false"
          }
        }
      ]
    }
  ]
}
