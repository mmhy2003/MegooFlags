# MegooFlags worker node configuration. Copy to .env next to docker-compose.worker.yml and adjust.
# A worker serves /sdk/* and /ofrep/* from the control plane's signed snapshots. It needs no
# database, no Valkey and no MEGOOFLAGS_SECRET_KEY.

# Image version. Before 1.0 a worker must run the same 0.Y release as the control plane: pin the
# control plane's exact release, e.g. MEGOOFLAGS_VERSION=0.1.0, and upgrade the control plane first.
MEGOOFLAGS_VERSION=latest

# Required. The control plane's external URL, e.g. https://flags.example.com. It must be https://
# unless MEGOOFLAGS_CONTROL_PLANE_INSECURE=true.
MEGOOFLAGS_CONTROL_PLANE_URL=

# Required. The node token shown once when you add the worker on the control plane's Nodes page
# (it starts with mf_node_). Rotating or revoking the node there replaces or invalidates it.
MEGOOFLAGS_NODE_TOKEN=

# Allow a plain http:// control-plane URL. Only for a private network or tests.
MEGOOFLAGS_CONTROL_PLANE_INSECURE=false

# Trust a private CA for the control plane's certificate. Put the PEM file in ./certs next to the
# compose file (mounted read-only at /etc/megooflags/certs), e.g.
# MEGOOFLAGS_CONTROL_PLANE_CA_FILE=/etc/megooflags/certs/ca.crt. Leave empty for public CAs.
MEGOOFLAGS_CONTROL_PLANE_CA_FILE=

# The worker keeps its snapshots and event buffer in the worker_data volume, mounted at the default
# data directory, so a restarted worker serves without the control plane. Keep the default.
# MEGOOFLAGS_DATA_DIR=/var/lib/megooflags

# Disk space in MB for exposure events and evaluation counts buffered while the control plane is
# unreachable. Past it, the oldest exposure events are dropped (counted in
# megooflags_worker_events_dropped_total); evaluation counts are kept.
MEGOOFLAGS_WORKER_BUFFER_MAX_MB=64

# Seconds a draining worker keeps its open SDK streams before it closes them. It reports not ready
# at once, so the load balancer sends new clients to the other workers.
MEGOOFLAGS_WORKER_DRAIN_GRACE_SECONDS=30

# TLS mode, chosen by this one value, as on the control plane:
# - Empty (default): plain HTTP on port 80 only, behind your load balancer, which terminates TLS
#   and health-checks /readyz. Port 443 is not published.
# - A domain, e.g. worker-1.flags.example.com: automatic HTTPS with a Let's Encrypt certificate.
#   The domain's DNS must point at this host and ports 80 and 443 must be reachable.
MEGOOFLAGS_SITE_ADDRESS=

# Host port for plain HTTP. With a domain, keep 80 for the ACME HTTP-01 challenge.
MEGOOFLAGS_HTTP_PORT=80

# Proxies whose X-Forwarded-* headers Caddy passes on to the worker (Caddy syntax).
# Default: private IP ranges. Add your load balancer's address if it is public.
MEGOOFLAGS_TRUSTED_PROXIES=private_ranges

# Log level (DEBUG, INFO, WARNING, ERROR). Logs are JSON lines on stdout.
MEGOOFLAGS_LOG_LEVEL=INFO

# Requests per minute allowed for each client SDK key and client IP, counted on this worker.
MEGOOFLAGS_CLIENT_RATE_LIMIT_PER_MINUTE=600

# Seconds between heartbeats on open SDK streams (server-sent events).
MEGOOFLAGS_SSE_HEARTBEAT_SECONDS=15

# OpenTelemetry traces. Off unless an OTLP/HTTP endpoint is set.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=megooflags-worker
OTEL_TRACES_SAMPLER_ARG=1.0

# Prometheus metrics (including megooflags_worker_snapshot_age_seconds) are served on
# api:8000/metrics inside the compose network only; Caddy answers 404.
