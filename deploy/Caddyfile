{
	servers {
		trusted_proxies static {$MEGOOFLAGS_TRUSTED_PROXIES:private_ranges}
	}
}

{$MEGOOFLAGS_SITE_ADDRESS::80} {
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}
	# HSTS only over HTTPS: in plain-HTTP mode TLS is terminated (or not) by another proxy.
	@https protocol https
	header @https Strict-Transport-Security "max-age=31536000; includeSubDomains"

	# Metrics stay inside the compose network: Prometheus scrapes each api replica on :8000.
	respond /metrics 404

	@api path /api/* /sdk/* /ofrep/* /healthz /readyz
	reverse_proxy @api {
		# Every replica of `docker compose up --scale api=N`, re-resolved every 5s.
		dynamic a api 8000 {
			refresh 5s
		}
		lb_policy round_robin
		lb_try_duration 5s
		flush_interval -1
	}
	reverse_proxy web:3000
}
