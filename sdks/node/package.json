{
  "name": "@megooflags/node",
  "version": "0.1.0",
  "description": "MegooFlags server SDK for Node.js: an OpenFeature provider that evaluates flags in-process",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mmhy2003/MegooFlags.git",
    "directory": "sdks/node"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run test/",
    "test:p99": "vitest run perf/ --reporter=default",
    "e2e": "vitest run e2e/"
  },
  "peerDependencies": {
    "@openfeature/server-sdk": "^1.23.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@openfeature/server-sdk": "^1.23.0",
    "@types/node": "^22.20.5",
    "eslint": "^9.39.5",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.34.9"
}
