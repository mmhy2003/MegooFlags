        {"name": "default", "featureName": "new-checkout", "title": "From the office", "disabled": false, "sortOrder": 11, "segments": [2, 3],
         "constraints": [], "parameters": {}, "variants": []},

        {"name": "flexibleRollout", "featureName": "checkout-theme", "title": "Swedes", "disabled": false, "sortOrder": 0, "segments": [],
