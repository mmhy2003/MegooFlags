      "id": 1,
      "name": "beta-testers",
      "description": "Opted into the beta",
      "constraints": [
        {"contextName": "email", "operator": "STR_ENDS_WITH", "values": ["@example.com"], "inverted": false, "caseInsensitive": true},
        {"contextName": "plan", "operator": "IN", "values": ["pro", "enterprise"], "inverted": false, "caseInsensitive": false}
      ]
    },
    {
      "id": 2,
      "name": "Office IPs",
      "description": "",
      "constraints": [
        {"contextName": "remoteAddress", "operator": "IN_CIDR", "values": ["10.0.0.0/8"], "inverted": false, "caseInsensitive": false}
      ]
    },
    {"id": 3, "name": "everyone", "description": "No constraints", "constraints": []}
  ],
  "perEnv": {
